# Terraform working directories and generated files.
.terraform/

# Terraform state and plan artifacts.
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json

# Crash logs.
crash.log
crash.*.log

# Variable files may contain secrets.
*.tfvars
*.tfvars.json

# Local Terragrunt cache.
.terragrunt-cache/

# Terraform provider lock files are intentionally not ignored.
# Commit .terraform.lock.hcl for reproducible provider selection.
